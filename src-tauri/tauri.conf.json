{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ALRU",
  "version": "0.1.0",
  "identifier": "com.jinpearl.alru",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Amplify Lambda Runtime Updater",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/amplify.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
